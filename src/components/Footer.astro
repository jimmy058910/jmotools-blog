	<p class="copyright">&copy; {today.getFullYear()} JMoGaming LLC. All rights reserved.</p>
</footer>
<style>
	footer {
		padding: 2em 1em;
		background: var(--bg-secondary);
		border-top: 1px solid var(--border-color);
		color: var(--text-muted);
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.25em;
		margin-bottom: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: var(--text-muted);
		transition: color var(--transition-fast);
		display: flex;
		align-items: center;
	}
	.social-links a:hover {
		color: var(--primary-color);
	}
	.copyright {
		margin: 0;
		font-size: 0.85em;
		color: var(--text-muted);
	}
</style>
