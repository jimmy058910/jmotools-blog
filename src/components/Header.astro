---
const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo" aria-label="JMo Security Blog home">
        <span class="logo-icon">⚡</span>
        <span class="logo-text">
          <span class="logo-brand">JMo Security</span>
          <span class="logo-sub">Blog</span>
        </span>
      </a>

      <nav aria-label="Main navigation">
        <a href="/" class={currentPath === '/' ? 'nav-link active' : 'nav-link'}>Posts</a>
        <a href="/rss.xml" class="nav-link" title="RSS Feed" aria-label="RSS Feed">RSS</a>
        <a href="https://jmotools.com" class="nav-link nav-external" target="_blank" rel="noopener">
          jmotools.com
          <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 2h8v8M10 2L2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="https://github.com/jimmy058910/jmo-security-repo" class="btn-github" target="_blank" rel="noopener">
          GitHub
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 14, 39, 0.95);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-icon {
    font-size: 1.2rem;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-brand {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .logo-sub {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--primary-color);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text-primary);
    background: var(--bg-tertiary);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--primary-color);
  }

  .btn-github {
    padding: 0.35rem 0.9rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition: all var(--transition-fast);
    margin-left: 0.25rem;
  }

  .btn-github:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
    box-shadow: var(--glow-primary);
    text-decoration: none;
  }

  @media (max-width: 500px) {
    .nav-link:not(.active):not(.btn-github) {
      display: none;
    }
  }
</style>
