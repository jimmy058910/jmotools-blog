---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-left">
        <span class="footer-copy">© {year} JMo Gaming LLC</span>
        <span class="footer-sep">·</span>
        <a href="https://jmotools.com" target="_blank" rel="noopener">jmotools.com</a>
        <span class="footer-sep">·</span>
        <a href="https://github.com/jimmy058910/jmo-security-repo" target="_blank" rel="noopener">MIT License</a>
      </div>
      <div class="footer-right">
        <a href="/rss.xml" title="RSS Feed">RSS</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-color);
    padding: 1.25rem 0;
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .footer-sep {
    color: var(--border-color);
  }

  a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a:hover {
    color: var(--primary-color);
  }
</style>
