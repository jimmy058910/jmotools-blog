---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="JMo Security Blog"
  description="Writing on DevSecOps, security tooling, and the JMo Security suite — by Jimmy, CompTIA-certified SOC engineer at BAE Systems."
>
  <div class="blog-index">
    <div class="container">
      <section class="hero">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          DevSecOps · Security Engineering · Open Source
        </div>
        <h1>
          <span class="gradient-text">JMo Security</span> Blog
        </h1>
        <p class="hero-lead">
          Writing on security tooling, DevSecOps workflows, and building JMo Security in the open.
          By Jimmy — CompTIA-certified SOC engineer at BAE Systems.
        </p>
        <div class="hero-links">
          <a href="https://jmotools.com" class="btn-primary" target="_blank" rel="noopener">
            jmotools.com →
          </a>
          <a href="https://github.com/jimmy058910/jmo-security-repo" class="btn-secondary" target="_blank" rel="noopener">
            GitHub
          </a>
        </div>
      </section>

      <section class="posts-section">
        <h2 class="section-label">All Posts</h2>
        {posts.length === 0 ? (
          <p class="empty-state">No posts yet. Check back soon.</p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-card">
                <a href={`/blog/${post.slug}`} class="post-card-link">
                  <div class="post-card-inner">
                    <div class="post-card-meta">
                      <time datetime={post.data.pubDate.toISOString()} class="post-card-date">
                        {post.data.pubDate.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </time>
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="tag">#{tag}</span>
                      ))}
                    </div>
                    <h3 class="post-card-title">{post.data.title}</h3>
                    <p class="post-card-description">{post.data.description}</p>
                  </div>
                  <span class="post-card-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-index {
    padding: 3rem 0 2rem;
  }

  /* Hero */
  .hero {
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-green);
    border-radius: 50%;
    display: inline-block;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .hero-lead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 580px;
    margin-bottom: 1.5rem;
    line-height: 1.65;
  }

  .hero-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    background: linear-gradient(135deg, var(--primary-color), var(--accent-cyan));
    color: var(--bg-primary);
    font-weight: 700;
    font-size: 0.875rem;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-primary:hover {
    box-shadow: var(--glow-primary);
    text-decoration: none;
    color: var(--bg-primary);
  }

  .btn-secondary {
    display: inline-block;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-secondary:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
    text-decoration: none;
  }

  /* Posts */
  .section-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 1.25rem;
    border: none;
    padding: 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    border-bottom: 1px solid var(--border-color);
  }

  .post-card:first-child {
    border-top: 1px solid var(--border-color);
  }

  .post-card-link {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.25rem 0;
    text-decoration: none;
    gap: 1rem;
    transition: all var(--transition-fast);
    border-radius: 0;
  }

  .post-card-link:hover {
    text-decoration: none;
  }

  .post-card-link:hover .post-card-title {
    color: var(--primary-color);
  }

  .post-card-link:hover .post-card-arrow {
    color: var(--primary-color);
    transform: translateX(3px);
  }

  .post-card-inner {
    flex: 1;
    min-width: 0;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .post-card-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .post-card-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: 0.35rem;
    transition: color var(--transition-fast);
  }

  .post-card-description {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0;
  }

  .post-card-arrow {
    font-size: 1.1rem;
    color: var(--border-color);
    flex-shrink: 0;
    transition: all var(--transition-fast);
    padding-top: 0.1rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.9rem;
  }
</style>
